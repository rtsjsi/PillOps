# Example environment file – copy to .env.local and fill in secrets

# GitHub Personal Access Token (for GPT-4o-mini via GitHub Models - Tier 1 OCR)
GITHUB_TOKEN=your-github-token

# Google Gemini API Key for OCR (Tier 2 OCR)
GEMINI_API_KEY=your-gemini-key

# Groq API Key
GROQ_API_KEY=your-groq-key

# Supabase configuration (public values — baked into client bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only, never expose to client)
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
