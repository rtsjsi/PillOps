# Example environment file - copy to .env.local and fill in secrets

# Groq API Key (primary OCR - free tier)
GROQ_API_KEY=your-groq-key

# Google Gemini API Key (OCR fallback - may fail from some Cloudflare regions)
GEMINI_API_KEY=your-gemini-key

# OpenRouter API Key (last-resort OCR fallback - pinned free vision models at openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-key
# Optional - sent as HTTP-Referer / X-Title headers to OpenRouter
OPENROUTER_SITE_URL=https://your-app.example.com
OPENROUTER_APP_NAME=PillOps

# Supabase configuration (public values - baked into client bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only, never expose to client)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
